<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Generate a NuGet lock file so the GitHub Actions NuGet cache (setup-dotnet cache:true)
         can key on it. Without this file the cache step fails with
         "Dependencies lock file is not found ... Supported file patterns: packages.lock.json". -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <ApplicationManifest>app.manifest</ApplicationManifest>

    <ApplicationIcon>active.ico</ApplicationIcon>
    <Version>2.1.1</Version>
    <FileVersion>2.1.1.0</FileVersion>
    <AssemblyVersion>2.1.1.0</AssemblyVersion>
    <Product>DesktopIconToggle</Product>
    <Company>Hexandcube</Company>
    <Authors>Hexandcube</Authors>
    <Copyright>Copyright © Hexandcube 2026</Copyright>
    <Description>A lightweight system utility to instantly toggle Windows desktop icons with a double-click.</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="active.ico" />
    <EmbeddedResource Include="suspended.ico" />
  </ItemGroup>

</Project>